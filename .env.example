# ==========================================
# PostgreSQL Configuration
# Used by: PostgreSQL
# ==========================================
POSTGRES_DB=emailapi
POSTGRES_USER=emailapi
POSTGRES_PASSWORD=dev_emailapi_password_change_me

# ==========================================
# Database Connection
# Used by: Ingestion API, Generation API, Sender Worker
# ==========================================
DATABASE_URL=postgresql://emailapi:dev_emailapi_password_change_me@postgres:5432/emailapi

# ==========================================
# RabbitMQ Configuration
# Used by: RabbitMQ
# ==========================================
RABBITMQ_USER=emailapi
RABBITMQ_PASSWORD=dev_rabbitmq_password_change_me

# ==========================================
# RabbitMQ Connection
# Used by: Generation API, Sender Worker
# ==========================================
RABBITMQ_URL=amqp://emailapi:dev_rabbitmq_password_change_me@rabbitmq:5672/

# ==========================================
# Internal Service Authentication
# Used by: Ingestion API, Generation API
# ==========================================
INTERNAL_TOKEN=dev_internal_token_change_me_8f7a2c9d4e6b1a5f3c8d
EMAIL_API_KEY=your_actual_api_key

# ==========================================
# Generation API
# Used by: Ingestion API
# ==========================================
GENERATION_API_URL=http://generation-api:8001

# ==========================================
# Ingestion API Configuration
# ==========================================
QUEUE_CAPACITY=1000
MAX_RECIPIENTS_PER_BATCH=1000
IDEMPOTENCY_TTL_HOURS=24
SWEEPER_AFTER_SECONDS=300

# ==========================================
# Sender Worker Configuration
# ==========================================

CONCURRENCY=75
PREFETCH_COUNT=150

SMTP_POOL_SIZE=100
SMTP_MAX_ACTIVE_CONNECTIONS=75
SMTP_MAX_EMAILS_PER_CONNECTION=20

# ==========================================
# SMTP Configuration
# Used by: Sender Worker
# ==========================================
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# ==========================================
# Logging Configuration
# ==========================================
LOG_LEVEL=INFO
TRACK_BASE_URL=http://localhost:8002
GENERATION_CONCURRENCY=40
PUBLISH_RATE_PER_SECOND=800